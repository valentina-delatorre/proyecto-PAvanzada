<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="site.master.cs" Inherits="Consultorio2026.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Consultorio</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%231f4b44'/%3E%3Cpath d='M4 17h7l2-6 3 11 2-5h10' fill='none' stroke='%23d7a34e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <%-- El tema (claro/oscuro) se aplica ANTES de dibujar la pagina, asi no hay un
         parpadeo blanco al entrar. Si nunca eligio, se usa el del sistema operativo. --%>
    <script>
        try {
            var tema = localStorage.getItem('tema') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro');
            document.documentElement.setAttribute('data-tema', tema);
        } catch (e) { }
    </script>
    <%-- Recurso() le suma "?v=..." con la fecha del archivo: cuando cambia el CSS o el JS,
         el navegador baja el nuevo en vez de usar el que tenia guardado. --%>
    <link href="<%= Recurso("~/Content/Theme.css") %>" rel="stylesheet" />
    <link href="<%= Recurso("~/Content/Site.css") %>" rel="stylesheet" />
    <link href="<%= Recurso("~/Content/Asistente.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="app-nav">
            <a runat="server" href="~/Inicio.aspx" class="app-nav-brand">Consultorio</a>

            <ul class="app-nav-links">
                <li><a runat="server" href="~/Usuarios/ListadoUsuarios.aspx" data-permiso="ABM Usuarios">Usuarios</a></li>
                <li><a runat="server" href="~/Especialistas/ListadoEspecialistas.aspx" data-permiso="ABM Especialistas">Especialistas</a></li>
                <li><a runat="server" href="~/Turnos/ListadoTurnos.aspx" data-permiso="Gestion de Turnos">Turnos</a></li>
                <li><a runat="server" href="~/Reportes/ReporteDiario.aspx" data-permiso="Ver Reportes">Reportes</a></li>
                <%-- Solo lo ve quien tenga el modulo "Seguridad y Accesos" (hoy, Valentina) --%>
                <li id="LiAccesos" runat="server" visible="false"><a runat="server" href="~/Seguridad/Accesos.aspx">Seguridad y accesos</a></li>
            </ul>

                        <div class="app-nav-user">
                <button type="button" id="temaBoton" class="tema-boton" title="Cambiar a modo oscuro" aria-label="Cambiar entre modo claro y oscuro">
                    <svg class="tema-luna" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                    <svg class="tema-sol" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
                <a runat="server" href="~/Cuenta/MiCuenta.aspx" class="app-nav-cuenta" title="Mi cuenta">
                    <svg class="icono-usuario" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
                        <path d="M4 20 C4 15.5 8 13.5 12 13.5 C16 13.5 20 15.5 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <asp:Label ID="LbUsuarioLogueado" runat="server" CssClass="app-nav-user-label" />
                </a>
                <asp:LinkButton ID="BtCerrarSesion" runat="server" Text="Cerrar sesión" OnClick="BtCerrarSesion_Click" CssClass="app-nav-logout" />
            </div>
        </nav>

        <div class="app-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <div id="modalAcceso" class="modal-overlay" style="display:none;">
            <div class="modal-box">
                <h3>Acceso restringido</h3>
                <p>No tenés acceso a este módulo.</p>
                <button type="button" class="btn" onclick="cerrarModalAcceso()">Entendido</button>
            </div>
        </div>

        <asp:Literal ID="LtRolScript" runat="server" />

        <%-- Asistente con IA (Ollama). Lo ve quien tenga el modulo "Asistente IA". --%>
        <asp:PlaceHolder ID="PhAsistente" runat="server" Visible="false">
            <button type="button" id="asistenteBoton" class="asistente-boton" title="Preguntale al asistente"
                data-url="<%= ResolveUrl("~/Asistente/Consultar.ashx") %>" data-usuario="<%= Session["IdUsuario"] %>">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="9" cy="10.5" r="1.2" fill="currentColor"/><circle cx="12" cy="10.5" r="1.2" fill="currentColor"/><circle cx="15" cy="10.5" r="1.2" fill="currentColor"/></svg>
                <span>Asistente</span>
            </button>
            <div id="asistentePanel" class="asistente-panel" hidden>
                <div class="asistente-cabecera">
                    <div>
                        <strong>Asistente del consultorio</strong>
                        <small><asp:Literal ID="LtAsistenteSub" runat="server" /></small>
                    </div>
                    <button type="button" id="asistenteCerrar" class="asistente-cerrar" title="Cerrar">&times;</button>
                </div>
                <div id="asistenteMensajes" class="asistente-mensajes"></div>
                <div id="asistenteSugerencias" class="asistente-sugerencias">
                    <asp:Literal ID="LtSugerencias" runat="server" />
                </div>
                <div class="asistente-escribir">
                    <input type="text" id="asistenteTexto" maxlength="400" placeholder="Escribí tu pregunta..." autocomplete="off" />
                    <button type="button" id="asistenteEnviar" class="btn">Enviar</button>
                </div>
            </div>
        </asp:PlaceHolder>

    </form>
    <script src="<%= Recurso("~/Content/Site.js") %>"></script>
    <script src="<%= Recurso("~/Content/Asistente.js") %>"></script>
</body>
</html>