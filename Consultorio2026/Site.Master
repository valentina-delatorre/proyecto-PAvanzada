<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="site.master.cs" Inherits="Consultorio2026.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>Consultorio</title>
    <link runat="server" href="~/Content/Theme.css" rel="stylesheet" />
    <link runat="server" href="~/Content/Site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="app-nav">
            <a runat="server" href="~/Inicio.aspx" class="app-nav-brand">Consultorio</a>

            <ul class="app-nav-links">
                <li><a runat="server" href="~/Usuarios/ListadoUsuarios.aspx" data-rol="Usuarios">Usuarios</a></li>
                <li><a runat="server" href="~/Especialistas/ListadoEspecialistas.aspx" data-rol="Especialistas">Especialistas</a></li>
                <li><a runat="server" href="~/Turnos/ListadoTurnos.aspx" data-rol="Turnos">Turnos</a></li>
                <li><a runat="server" href="~/Reportes/ReporteDiario.aspx" data-rol="Reportes">Reportes</a></li>
            </ul>

                        <div class="app-nav-user">
                <a runat="server" href="~/Cuenta/MiCuenta.aspx" class="app-nav-cuenta" title="Mi cuenta">
                    <svg class="icono-usuario" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
                        <path d="M4 20 C4 15.5 8 13.5 12 13.5 C16 13.5 20 15.5 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <asp:Label ID="LbUsuarioLogueado" runat="server" CssClass="app-nav-user-label" />
                </a>
                <asp:LinkButton ID="BtCerrarSesion" runat="server" Text="Cerrar sesión" OnClick="BtCerrarSesion_Click" CssClass="app-nav-logout" />
            </div>
        </nav>

        <div class="app-content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <div id="modalAcceso" class="modal-overlay" style="display:none;">
            <div class="modal-box">
                <h3>Acceso restringido</h3>
                <p>No tenés acceso a este módulo.</p>
                <button type="button" class="btn" onclick="cerrarModalAcceso()">Entendido</button>
            </div>
        </div>

        <asp:Literal ID="LtRolScript" runat="server" />

    </form>
    <script src="<%= ResolveUrl("~/Content/Site.js") %>"></script>
</body>
</html>