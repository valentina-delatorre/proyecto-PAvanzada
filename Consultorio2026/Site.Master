</asp:Panel>

<asp:Panel ID="PnMenuUsuarios" runat="server" Visible="false">
    <li><a runat="server" href="~/Usuarios/ListadoUsuarios.aspx">Usuarios</a></li>
</asp:Panel>

<asp:Panel ID="PnMenuEspecialistas" runat="server" Visible="false">
    <li><a runat="server" href="~/Especialistas/ListadoEspecialistas.aspx">Especialistas</a></li>
</asp:Panel>

<asp:Panel ID="PnMenuReportes" runat="server" Visible="false">
    <li><a runat="server" href="~/Reportes/ReporteDiario.aspx">Reportes</a></li>
</asp:Panel>
                </ul>

                <ul class="nav navbar-nav navbar-right">
                    <li><asp:Label ID="LbUsuarioLogueado" runat="server" CssClass="navbar-text" /></li>
                    <li><asp:LinkButton ID="BtCerrarSesion" runat="server" Text="Cerrar sesión" OnClick="BtCerrarSesion_Click" CssClass="navbar-link" /></li>
                </ul>
            </div>
        </nav>

        <div class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
