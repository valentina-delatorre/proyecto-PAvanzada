<configuration>
	<!-- El sistema usa SIEMPRE la conexion que se llama "ConsultorioDB".
	     Las otras quedan guardadas con nombre para no perderlas.
	     Cada uno tiene que apuntar ConsultorioDB a SU SQL Server: si tu
	     instancia se llama distinto, cambia el Data Source de abajo. -->
	<connectionStrings>
		<add name="ConsultorioDB_facultad" connectionString="Data Source=26.216.108.167;Initial Catalog=ConsultorioI;User ID=Grupo06;Password=gru06poUsal2026!"
			 providerName="System.Data.SqlClient" />
		<add name="ConsultorioDB_valentina" connectionString="Data Source=DESKTOP-7SJKAVE\SQLEXPRESS01;Initial Catalog=ConsultorioI;User ID=sa;Password=Valentina2026!"
					 providerName="System.Data.SqlClient" />
		<add name="ConsultorioDB" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ConsultorioI;Integrated Security=True"
					 providerName="System.Data.SqlClient" />

		
	</connectionStrings>

	<!-- Servidor de salida para los códigos de verificación.
	     Con Gmail hay que generar una "contraseña de aplicación" (no sirve la
	     contraseña normal de la cuenta) y pegarla en password. -->
	<system.net>
		<mailSettings>
			<smtp from="COMPLETAR@gmail.com">
				<network host="smtp.gmail.com" port="587" enableSsl="true"
						 userName="COMPLETAR@gmail.com" password="COMPLETAR-CONTRASENIA-DE-APLICACION" />
			</smtp>
		</mailSettings>
	</system.net>

	<!-- Asistente con IA: Ollama corriendo en esta misma maquina.
	     Para cambiar de modelo: "ollama pull <modelo>" y cambiar OllamaModelo. -->
	<appSettings>
		<add key="OllamaUrl" value="http://localhost:11434" />
		<add key="OllamaModelo" value="qwen2.5:7b" />
	</appSettings>

	<location path="Seguridad/Accesos.aspx">
		<system.web>
			<authorization>
				<deny users="?" />
			</authorization>
		</system.web>
	</location>

	<location path="Inicio.aspx">
		<system.web>
			<authorization>
				<deny users="?" />
			</authorization>
		</system.web>
	</location>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />

		<sessionState timeout="30" />

		<authentication mode="Forms">
			<forms loginUrl="~/Seguridad/Login.aspx" timeout="30" />
		</authentication>
	</system.web>
</configuration>